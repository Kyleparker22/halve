{
  "name": "halve",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @halve/mobile dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:games": "vitest run --project games",
    "test:ledger": "vitest run --project ledger",
    "test:db": "vitest run --project db",
    "coverage": "vitest run --coverage",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "gen:types": "supabase gen types typescript --linked > packages/types/src/database.ts.new && mv packages/types/src/database.ts.new packages/types/src/database.ts",
    "db:reset": "supabase db reset",
    "build:functions": "node scripts/build-functions.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.2.4"
  }
}
