# Copy to .env. The anon key is public by design — RLS is the boundary.
# The service role key must never appear in this app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

EXPO_PUBLIC_SENTRY_DSN=

# Source-map upload is disabled on EAS builds until Sentry is actually set up.
# When you add a DSN above, create a Sentry auth token, set it as an EAS secret
# (`eas env:create --name SENTRY_AUTH_TOKEN --visibility secret`), and delete
# the SENTRY_DISABLE_AUTO_UPLOAD variable — without source maps a crash report
# is a stack of minified line numbers.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
